@{
    ViewData["Title"] = "Node Manager";
}

<div class="workspace" id="overview">
    <header class="workspace-header">
        <div>
            <p class="eyebrow">Network Management UA</p>
            <h1>Operational overview</h1>
            <p class="workspace-introduction">
                Discover local participants, inspect Current Parameters, and manage Router access.
            </p>
        </div>
        <div class="workspace-context" aria-label="Current management scope">
            <span>Management scope</span>
            <strong>26.100</strong>
            <small>Local Communications Node</small>
        </div>
    </header>

    <div class="dashboard-grid">
        <section class="panel panel-compact" aria-labelledby="current-capabilities">
            <p class="panel-kicker">Current capability</p>
            <h2 id="current-capabilities">Manage this local node</h2>
            <dl class="scope-details">
                <div>
                    <dt>Node</dt>
                    <dd>26.100</dd>
                </div>
                <div>
                    <dt>Participant ports</dt>
                    <dd>1-63</dd>
                </div>
            </dl>
            <p>
                Start with a Network scan, then select a discovered participant to inspect its
                Current Parameter Table.
            </p>
        </section>

        <section class="panel panel-compact" id="router-access" aria-labelledby="node-login">
            <p class="panel-kicker">Administration</p>
            <h2 id="node-login">Node Login</h2>
            <p>Log on a User Agent at the local Router.</p>

            <form class="login-form" id="router-logon" action="/router/parameters/logon" method="post">
                <label>
                    Password Level
                    <select name="passwordLevel">
                        <option value="1" selected>Level 1</option>
                        <option value="2">Level 2</option>
                        <option value="3">Level 3</option>
                        <option value="4">Level 4</option>
                    </select>
                </label>
                <label>
                    Password
                    <input type="password" name="password" required />
                </label>
                <label>
                    Brigade or Agency
                    <input type="number" name="brigade" min="0" max="255" required />
                </label>
                <label>
                    Node
                    <input type="number" name="node" min="0" max="65535" required />
                </label>
                <label>
                    Port
                    <input type="number" name="port" min="0" max="255" required />
                </label>
                <button type="submit">Log on</button>
            </form>

            <p id="router-logon-status" role="status" hidden></p>
        </section>

        <section class="panel panel-wide" id="network" aria-labelledby="participant-discovery-heading">
            <p class="panel-kicker">Network</p>
            <h2 id="participant-discovery-heading">Local participant discovery</h2>
            <p>
                Scan the 63 participant ports on this Communications Node for the Router,
                Message Transfer Agents, and User Agents.
            </p>

            <form class="inline-action" id="router-participant-discovery" action="/router/participants/discovery" method="post">
                <button id="router-participant-discovery-submit" type="submit">Discover local participants</button>
            </form>

            <p id="router-participant-discovery-status" role="status" hidden></p>
            <table id="router-participant-discovery-results" hidden>
                <caption>Discovered local participants</caption>
                <thead>
                    <tr>
                        <th scope="col">Port</th>
                        <th scope="col">Kind</th>
                        <th scope="col">Agent Type</th>
                        <th scope="col">Parameters</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            <div id="router-participant-discovery-summary" hidden></div>
        </section>

        <section class="panel panel-wide" id="parameters" aria-labelledby="router-parameter-list-heading">
            <p class="panel-kicker">Parameters</p>
            <h2 id="router-parameter-list-heading">Participant Parameters</h2>
            <p class="panel-description">
                Select a Parameter Table, then select <strong>View parameters</strong> in Local
                participant discovery to inspect the participant's values.
            </p>
            <label class="parameter-table-selector">
                Parameter Table
                <select id="participant-parameter-table">
                    <option value="permanent">Permanent</option>
                    <option value="non-volatile">Non-Volatile</option>
                    <option value="current" selected>Current</option>
                </select>
            </label>
            <form class="inline-action" id="router-routing-table-entry-selection"
                  aria-describedby="router-routing-table-entry-selection-status">
                <fieldset>
                    <legend>Router Routing Table entries</legend>
                    <label>
                        First entry
                        <input name="first-entry" type="number" min="1" value="1" required />
                    </label>
                    <label>
                        Last entry
                        <input name="last-entry" type="number" min="1" value="1" required />
                    </label>
                    <button type="submit">Request entries</button>
                </fieldset>
            </form>
            <p id="router-routing-table-entry-selection-status" role="status" hidden></p>
            <ul id="router-routing-table-entry-results" hidden></ul>
            <button id="router-routing-table-next-page" hidden type="button" disabled
                    aria-controls="router-routing-table-entry-results">Next entries</button>
            <p>
                <a href="/router/parameters/tables">Browse Router Parameter Tables</a>
            </p>
            <p id="router-parameter-list-status" role="status" hidden></p>
            <table id="router-parameter-list" hidden>
                <caption>Local Router Current Parameters</caption>
                <thead>
                    <tr>
                        <th scope="col">Number</th>
                        <th scope="col">Parameter</th>
                        <th scope="col">Value</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </section>

        <section class="panel panel-wide" aria-labelledby="router-parameters">
            <p class="panel-kicker">Parameters</p>
            <h2 id="router-parameters">Local Router</h2>
            <p>Request the configured Brigade or Agency number from the local Router.</p>

            <form class="inline-action" id="router-brigade-request"
                  action="/router/parameters/brigade-or-agency-number"
                  method="post">
                <button type="submit">Get Brigade or Agency number</button>
            </form>

            <p id="router-brigade-status" role="status" hidden></p>
        </section>
    </div>
</div>

<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/js/management-transactions.js"></script>
<script>
    const requestForm = document.getElementById("router-brigade-request");
    const status = document.getElementById("router-brigade-status");
    const logonForm = document.getElementById("router-logon");
    const logonStatus = document.getElementById("router-logon-status");
    const discoveryForm = document.getElementById("router-participant-discovery");
    const discoveryButton = document.getElementById("router-participant-discovery-submit");
    const discoveryStatus = document.getElementById("router-participant-discovery-status");
    const discoveryResults = document.getElementById("router-participant-discovery-results");
    const discoveryResultRows = discoveryResults.querySelector("tbody");
    const discoverySummary = document.getElementById("router-participant-discovery-summary");
    const routerParameterList = document.getElementById("router-parameter-list");
    const routerParameterListStatus = document.getElementById("router-parameter-list-status");
    const routerParameterListRows = routerParameterList.querySelector("tbody");
    const participantParameterTable = document.getElementById("participant-parameter-table");
    const routerRoutingTableEntrySelection = document.getElementById("router-routing-table-entry-selection");
    const routerRoutingTableEntrySelectionStatus =
        document.getElementById("router-routing-table-entry-selection-status");
    const routerRoutingTableEntryResults = document.getElementById("router-routing-table-entry-results");
    const routerRoutingTableNextPage = document.getElementById("router-routing-table-next-page");
    let nextRoutingTableEntryRange = null;
    const redactedPasswordMarker = "PASSWORD";
    const participantCurrentParameterCatalogues = {
        router: [
            { number: 1, name: "Brigade or Agency" },
            { number: 2, name: "Node Number" },
            { number: 3, name: "Node Name" },
            { number: 4, name: "Current Password" },
            { number: 5, name: "Level 1 Password" },
            { number: 6, name: "Level 2 Password" },
            { number: 7, name: "Level 3 Password" },
            { number: 8, name: "Level 4 Password" },
            { number: 9, name: "Maximum Message Length" },
            { number: 10, name: "Network Manager Address 1" },
            { number: 11, name: "Network Manager Address 2" },
            { number: 12, name: "No Acknowledgement Timeout" },
            { number: 18, name: "Manual Acknowledgement Timeout" },
            { number: 19, name: "Retries" },
            { number: 20, name: "Time and Date" },
        ],
        "LAN MTA (10)": [
            { number: 1, name: "Port Number" },
            { number: 2, name: "Agent Type" },
            { number: 3, name: "Interface Status" },
            { number: 4, name: "Notify Status Changes" },
            { number: 5, name: "Frame Transmit Count" },
            { number: 6, name: "Frame Receive Count" },
            { number: 7, name: "Frame Transmit Failure Count" },
            { number: 8, name: "Frame Receive Failure Count" },
            { number: 9, name: "Minimum Message Priority" },
            { number: 10, name: "Next Nodes" },
            { number: 21, name: "LAN Address" }
        ],
        "Printer (4)": [
            { number: 1, name: "Port Number" },
            { number: 2, name: "Agent Type" },
            { number: 3, name: "Control Address" },
            { number: 21, name: "Default Source" },
            { number: 22, name: "Notify Printer Available" },
            { number: 23, name: "Alternative Source" },
            { number: 24, name: "Reprint Message" }
        ],
        "Network Management UA (12)": [
            { number: 1, name: "Port Number" },
            { number: 2, name: "Agent Type" },
            { number: 3, name: "Control Address" }
        ]
    };

    const getCurrentParameterCatalogue = participant =>
        participant.kind === "router"
            ? participantCurrentParameterCatalogues.router
            : participantCurrentParameterCatalogues[participant.agentType];

    const participantName = participant =>
        participant.kind === "router" ? "Router" : participant.agentType;

    const formatParameterTable = parameterTable => parameterTable === "non-volatile"
        ? "Non-Volatile"
        : parameterTable === "permanent"
            ? "Permanent"
            : "Current";

    const renderPendingParameters = (participant, parameterTable, parameters) => {
        routerParameterList.hidden = false;
        routerParameterListStatus.hidden = false;
        routerParameterList.querySelector("caption").textContent =
            `${participantName(participant)} ${formatParameterTable(parameterTable)} Parameters`;
        routerParameterListStatus.textContent =
            `${participantName(participant)} ${formatParameterTable(parameterTable)} Parameters selected.`;
        routerParameterListRows.replaceChildren();
        const valueCells = new Map();

        for (const parameter of parameters) {
            const row = document.createElement("tr");

            for (const [index, value] of [parameter.number, parameter.name, "Pending"].entries()) {
                const cell = document.createElement("td");
                cell.textContent = value;
                row.append(cell);
                if (index === 2) {
                    valueCells.set(parameter.number, cell);
                }
            }

            routerParameterListRows.append(row);
        }

        return valueCells;
    };

    const displayParameterValue = (participant, parameter) => {
        if (participant.kind === "router" &&
            parameter.parameterNumber >= 5 &&
            parameter.parameterNumber <= 8) {
            return redactedPasswordMarker;
        }

        return parameter.parameterValue;
    };

    const requestParticipantParameter = async (participant, parameterTable, parameter, valueCell) => {
        try {
            const requestUrl = participant.kind === "router"
                ? `/router/parameters/${parameterTable}/${parameter.number}`
                : `/participants/${participant.port}/parameters/${parameterTable}/${parameter.number}`;
            const result = await managementTransactions.submit(requestUrl, {
                method: "POST"
            });

            valueCell.textContent = result.state === "received"
                ? displayParameterValue(participant, result)
                    ?? "The Parameter Request did not return a value."
                : `Parameter Request ${result.state}.`;
        } catch {
            valueCell.textContent = "The Parameter Request could not be submitted.";
        }
    };

    const requestParticipantParameters = async (participant, button) => {
        const parameters = getCurrentParameterCatalogue(participant);
        const parameterTable = participantParameterTable.value;
        if (!parameters) {
            routerParameterList.hidden = true;
            routerParameterListRows.replaceChildren();
            routerParameterListStatus.hidden = false;
            routerParameterListStatus.textContent =
                "No Current Parameter catalogue is available for this participant.";
            return;
        }

        button.disabled = true;
        const formattedParameterTable = formatParameterTable(parameterTable);
        const valueCells = renderPendingParameters(participant, parameterTable, parameters);
        routerParameterListStatus.textContent =
            `Requesting ${participantName(participant)} ${formattedParameterTable} Parameters...`;

        try {
            await Promise.all(parameters.map(parameter =>
                requestParticipantParameter(
                    participant,
                    parameterTable,
                    parameter,
                    valueCells.get(parameter.number))));

            routerParameterListStatus.textContent =
                `${participantName(participant)} ${formattedParameterTable} Parameters completed.`;
        } finally {
            button.disabled = false;
        }
    };

    requestForm.addEventListener("submit", async event => {
        event.preventDefault();
        status.hidden = false;
        status.textContent = "Requesting Brigade or Agency number...";

        try {
            const request = await managementTransactions.submit(requestForm.action, { method: "POST" });
            status.textContent = request.state === "received"
                ? `Brigade or Agency number: ${request.brigadeOrAgencyNumber}`
                : `The Router Parameter Request ${request.state}.`;
        } catch {
            status.textContent = "The Router Parameter Request could not be submitted.";
        }
    });

    const requestRoutingTableEntries = async (firstEntry, lastEntry) => {
        nextRoutingTableEntryRange = null;
        routerRoutingTableNextPage.hidden = true;
        routerRoutingTableNextPage.disabled = true;
        routerRoutingTableEntrySelectionStatus.hidden = false;
        routerRoutingTableEntryResults.hidden = true;
        routerRoutingTableEntryResults.replaceChildren();
        routerRoutingTableEntrySelectionStatus.textContent = "Requesting Routing Table entries...";
        let request;
        try {
            request = await managementTransactions.submit(
            `/router/parameters/${participantParameterTable.value}/13/entries/${firstEntry}-${lastEntry}`,
            { method: "POST" });
        } catch {
            routerRoutingTableEntrySelectionStatus.textContent =
                "The Routing Table request could not be submitted.";
            return;
        }

        if (request.state !== "received") {
            routerRoutingTableEntrySelectionStatus.textContent =
                request.rejectionReason
                    ? `Routing Table request ${request.state}: ${request.rejectionReason}.`
                    : `Routing Table request ${request.state}.`;
            return;
        }

        const entries = request.routingTableEntries ?? [];
        const hasMoreValues = request.moreValues === true;
        for (const entry of entries) {
            const item = document.createElement("li");
            item.textContent = `Routing Table entry ${entry.index}: next node ${entry.nextNode}`;
            routerRoutingTableEntryResults.append(item);
        }

        routerRoutingTableEntryResults.hidden = false;
        nextRoutingTableEntryRange = hasMoreValues && entries.length > 0
            ? { firstEntry: entries.at(-1).index + 1, lastEntry }
            : null;
        const hasNextPage = nextRoutingTableEntryRange !== null;
        routerRoutingTableNextPage.hidden = !hasNextPage;
        routerRoutingTableNextPage.disabled = !hasNextPage;
        routerRoutingTableEntrySelectionStatus.textContent = entries.length === 0
            ? "No Routing Table entries were returned."
            : "Routing Table entries received.";
    };

    routerRoutingTableEntrySelection.addEventListener("submit", async event => {
        event.preventDefault();
        const formData = new FormData(routerRoutingTableEntrySelection);
        const firstEntry = Number(formData.get("first-entry"));
        const lastEntry = Number(formData.get("last-entry"));

        if (!Number.isInteger(firstEntry) || !Number.isInteger(lastEntry) ||
            firstEntry < 1 || lastEntry < firstEntry) {
            routerRoutingTableEntrySelectionStatus.hidden = false;
            routerRoutingTableEntrySelectionStatus.textContent =
                "Last entry must be greater than or equal to first entry.";
            return;
        }

        requestRoutingTableEntries(firstEntry, lastEntry);
    });

    routerRoutingTableNextPage.addEventListener("click", () => {
        if (nextRoutingTableEntryRange !== null) {
            requestRoutingTableEntries(nextRoutingTableEntryRange.firstEntry, nextRoutingTableEntryRange.lastEntry);
        }
    });

    logonForm.addEventListener("submit", async event => {
        event.preventDefault();
        logonStatus.hidden = false;
        logonStatus.textContent = "Logging on...";

        try {
            const login = await managementTransactions.submit(logonForm.action, {
                method: "POST",
                body: new FormData(logonForm)
            });
            logonStatus.textContent = login.userAgentAddress
                ? `Node Login ${login.state} for User-Agent address ${login.userAgentAddress}.`
                : `Node Login ${login.state}.`;
        } catch {
            logonStatus.textContent = "The Node Login could not be submitted.";
        }
    });

    const renderInventoryScan = scan => {
        discoveryStatus.hidden = false;
        discoveryStatus.textContent = `Inventory Scan: ${scan.completedProbeCount} of 63 probes completed.`;
        discoveryResults.hidden = false;
        discoveryResultRows.replaceChildren();

        for (const participant of scan.participants) {
            const row = document.createElement("tr");

            for (const value of [participant.port, participant.kind, participant.agentType ?? ""]) {
                const cell = document.createElement("td");
                cell.textContent = value;
                row.append(cell);
            }

            const parametersCell = document.createElement("td");
            const viewParametersButton = document.createElement("button");
            viewParametersButton.type = "button";
            viewParametersButton.textContent = "View parameters";
            viewParametersButton.disabled = scan.completedProbeCount < 63;
            viewParametersButton.addEventListener("click", () =>
                requestParticipantParameters(participant, viewParametersButton));
            parametersCell.append(viewParametersButton);
            row.append(parametersCell);

            discoveryResultRows.append(row);
        }

        if (scan.completedProbeCount === 63) {
            const negativeAcknowledgements = Object.entries(scan.summary.negativeAcknowledgements)
                .map(([reason, count]) => `${reason}: ${count}`)
                .join(", ") || "none";

            discoverySummary.hidden = false;
            discoverySummary.textContent =
                `Discovered participants: ${scan.summary.discoveredParticipantCount}. ` +
                `Timeouts: ${scan.summary.timeoutCount}. ` +
                `Delivery failures: ${scan.summary.deliveryFailureCount}. ` +
                `Negative acknowledgements: ${negativeAcknowledgements}.`;
        }
    };

    discoveryForm.addEventListener("submit", async event => {
        event.preventDefault();
        discoveryButton.disabled = true;
        discoveryStatus.hidden = false;
        discoveryStatus.textContent = "Discovering local participants...";
        discoveryResults.hidden = true;
        discoverySummary.hidden = true;

        const response = await fetch(discoveryForm.action, { method: "POST" });
        const statusUrl = response.url;

        if (!response.ok || !statusUrl) {
            discoveryStatus.textContent = "The Inventory Scan could not be submitted.";
            discoveryButton.disabled = false;
            return;
        }

        const poll = async () => {
            const result = await fetch(statusUrl);

            if (!result.ok) {
                discoveryStatus.textContent = "The Inventory Scan could not be completed.";
                discoveryButton.disabled = false;
                return;
            }

            const scan = await result.json();
            renderInventoryScan(scan);

            if (scan.completedProbeCount < 63) {
                window.setTimeout(poll, 1000);
                return;
            }

            discoveryButton.disabled = false;
        };

        poll();
    });
</script>