@{
	var address = Context.Request.Query["address"].ToString();
	var addressQuery = string.IsNullOrWhiteSpace(address)
		? string.Empty
		: $"?address={Uri.EscapeDataString(address)}";
	var path = Context.Request.Path;
	var isOverview = path == "/";
	var isNetwork = path.StartsWithSegments("/network");
	var isParameters = path.StartsWithSegments("/parameters");
}
<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>@(ViewData["Title"] ?? "Node Manager") | GD-92</title>
		<link rel="stylesheet" href="~/css/site.css" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<header class="app-header">
			<a class="brand" href="/" aria-label="GD-92 Node Manager home">
				<span class="brand-mark" aria-hidden="true">GD</span>
				<span>
					<span class="brand-product">GD-92</span>
					<span class="brand-name">Node Manager</span>
				</span>
			</a>
			<div class="station-identity">
				<span class="status-indicator" aria-hidden="true"></span>
				<span>Station End</span>
				<span class="station-address">26.100</span>
			</div>
		</header>
		<div class="app-shell">
			<nav class="app-navigation" aria-label="Node Manager">
				<p class="navigation-label">Workspace</p>
				<a class="navigation-link@(isOverview ? " is-active" : "")" href="/" aria-current="@(isOverview ? "page" : null)">Overview</a>
				<a class="navigation-link@(isNetwork ? " is-active" : "")" href="@($"/network{addressQuery}")" aria-current="@(isNetwork ? "page" : null)">Network</a>
				<a class="navigation-link@(isParameters ? " is-active" : "")" href="@($"/parameters{addressQuery}")" aria-current="@(isParameters ? "page" : null)">Parameters</a>
				<a class="navigation-link" href="#router-access">Router access</a>
			</nav>
			<main id="main-content" class="app-content">
				@RenderBody()
			</main>
		</div>
		<footer class="app-footer">
			<span>GD-92 Node Manager</span>
			<span>Station End</span>
		</footer>
		@RenderSection("Scripts", required: false)
	</body>
</html>