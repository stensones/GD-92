@using NodeManager.Parameters
@using NodeManager.Router.Parameters
@{
    Layout = "_Layout";
    ViewData["Title"] = "Parameters";
    var communicationsAddress = ViewData["SelectedCommunicationsAddress"] as string;
    var agentType = ViewData["AgentType"] as string;
    var parameterTable = ViewData["ParameterTable"] as string ?? "current";
    var parameterTableName = parameterTable switch
    {
        "permanent" => "Permanent",
        "non-volatile" => "Non-Volatile",
        _ => "Current"
    };
    var isRouter = ViewData["IsRouter"] as bool? ?? false;
    var participantParameters =
        ViewData["ParticipantParameters"] as IReadOnlyList<ParameterCatalogueEntry> ?? [];
    var participantPort = ViewData["ParticipantPort"] as byte?;
    var participantParametersAvailable =
        ViewData["ParticipantParametersAvailable"] as bool? ?? false;
    var selectedRouterParameter =
        ViewData["SelectedRouterParameter"] as ParameterCatalogueEntry;
    var routerParameters =
        ViewData["RouterParameters"] as IReadOnlyList<ParameterCatalogueEntry> ?? [];
    var selectedRouterTable =
        ViewData["SelectedRouterTable"] as RouterParameterTableDefinition;
    var selectedRouterTableResponseField = selectedRouterTable?.ParameterNumber.Value switch
    {
        13 => "routingTableEntries",
        14 => "pstnTableEntries",
        15 => "wanTableEntries",
        16 => "lanTableEntries",
        17 => "isdnTableEntries",
        21 => "mdtTableEntries",
        _ => null
    };
    var selectedRouterTableColumns = selectedRouterTable?.ParameterNumber.Value switch
    {
        13 => new[] { (Header: "Entry index", Property: "index"), (Header: "Next node", Property: "nextNode") },
        14 or 17 => new[]
        {
            (Header: "Entry index", Property: "index"),
            (Header: "Used", Property: "used"),
            (Header: "Next node", Property: "nextNode"),
            (Header: "Telephone number", Property: "telephoneNumber"),
            (Header: "Hold time", Property: "holdTime"),
            (Header: "Available", Property: "available")
        },
        15 => new[]
        {
            (Header: "Entry index", Property: "index"),
            (Header: "Used", Property: "used"),
            (Header: "Next node", Property: "nextNode"),
            (Header: "WAN address", Property: "wanAddress"),
            (Header: "Connect type", Property: "connectType")
        },
        16 => new[]
        {
            (Header: "Entry index", Property: "index"),
            (Header: "Used", Property: "used"),
            (Header: "Next node", Property: "nextNode"),
            (Header: "LAN address", Property: "lanAddress")
        },
        21 => new[]
        {
            (Header: "Entry index", Property: "index"),
            (Header: "Used", Property: "used"),
            (Header: "Next node", Property: "nextNode"),
            (Header: "Network user address", Property: "networkUserAddress"),
            (Header: "Hold time", Property: "holdTime"),
            (Header: "Available", Property: "available")
        },
        _ => []
    };
    var brigadeOrAgencyParameter = routerParameters.Single(
        parameter => parameter.Number == 1);
}

<div class="workspace">
    <header class="workspace-header">
        <div>
            <p class="eyebrow">Parameters</p>
            <h1>Parameters workspace</h1>
            <p class="workspace-introduction">
                Review Parameter Table values for the selected Participant.
            </p>
        </div>
        <div class="workspace-context" aria-label="Selected Participant context">
            <span>Selected Communications Address</span>
            <strong>@communicationsAddress</strong>
            <small>@agentType Agent Type</small>
        </div>
    </header>

    <div class="dashboard-grid parameters-workspace">
        <section class="panel" aria-labelledby="parameter-table-heading">
        <p class="panel-kicker">@parameterTableName parameter values</p>
        <h2 id="parameter-table-heading">Parameter Table</h2>
        <label for="parameter-table">Parameter Table</label>
        <select id="parameter-table" name="parameter-table">
            @if (parameterTable == "permanent")
            {
                <option selected>Permanent</option>
            }
            else
            {
            <option>Permanent</option>
            }
            @if (parameterTable == "non-volatile")
            {
                <option selected>Non-Volatile</option>
            }
            else
            {
            <option>Non-Volatile</option>
            }
            @if (parameterTable == "current")
            {
            <option selected>Current</option>
            }
            else
            {
                <option>Current</option>
            }
        </select>
        @if (isRouter)
        {
        @if (selectedRouterParameter is not null)
        {
        <section class="parameter-detail" aria-labelledby="current-router-parameter-detail-heading">
            <p class="panel-kicker">Current Router Parameter detail</p>
            <h3 id="current-router-parameter-detail-heading">
                Parameter @selectedRouterParameter.Number: @selectedRouterParameter.Name
            </h3>
            <p id="selected-router-parameter-value">No Parameter values have been read.</p>
            <form class="inline-action" id="selected-router-parameter-request"
                  action="/router/parameters/@parameterTable/@selectedRouterParameter.Number" method="post">
                <button id="selected-router-parameter-request-submit" type="submit">
                    Request @selectedRouterParameter.Name
                </button>
            </form>
            <p id="selected-router-parameter-request-status" role="status"
               aria-label="@selectedRouterParameter.Name Parameter read status">
                Pending, Received, Rejected, Timed out, Delivery failed.
            </p>
        </section>
        }
        <table>
            <caption>@parameterTableName Router Parameter Table</caption>
            <thead>
                <tr>
                    <th scope="col">Number</th>
                    <th scope="col">Name</th>
                    <th scope="col">Value</th>
                    <th scope="col">Read State</th>
                    <th scope="col">Last Read</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var parameter in routerParameters)
                {
                @if (parameter.Number == brigadeOrAgencyParameter.Number)
                {
                <tr>
                    <td>@parameter.Number</td>
                    <th scope="row">@parameter.Name</th>
                    <td id="brigade-or-agency-value">No Parameter values have been read.</td>
                    <td id="brigade-or-agency-read-state">Not read</td>
                    <td id="brigade-or-agency-last-read"></td>
                </tr>
                }
                else if (parameter.Kind == ParameterCatalogueEntryKind.ReadableScalar)
                {
                <tr>
                    <td>@parameter.Number</td>
                    <th scope="row">
                        <a href="@Url.Action("Index", "Parameters", new { address = communicationsAddress, agentType, parameterTable, selectedParameter = parameter.Number })">
                            @parameter.Name
                        </a>
                    </th>
                    <td id="router-parameter-@parameter.Number-value">
                        No Parameter values have been read.
                    </td>
                    <td id="router-parameter-@parameter.Number-read-state">Not read</td>
                    <td id="router-parameter-@parameter.Number-last-read"></td>
                </tr>
                }
                else if (parameter.Kind == ParameterCatalogueEntryKind.ProtectedScalar)
                {
                <tr>
                    <td>@parameter.Number</td>
                    <th scope="row">@parameter.Name</th>
                    <td>Protected; value redacted.</td>
                    <td>Protected</td>
                    <td></td>
                </tr>
                }
                else
                {
                <tr>
                    <td>@parameter.Number</td>
                    <th scope="row">
                        <a href="@Url.Action("Index", "Parameters", new { address = communicationsAddress, agentType, parameterTable, selectedTableParameter = parameter.Number })">
                            @parameter.Name
                        </a>
                    </th>
                    <td>No Parameter values have been read.</td>
                    <td>Not read</td>
                    <td></td>
                </tr>
                }
                }
            </tbody>
        </table>
        <form class="inline-action" id="brigade-or-agency-parameter-request"
              action="/router/parameters/@parameterTable/1" method="post">
            <button id="brigade-or-agency-parameter-request-submit" type="submit">
                Request Brigade or Agency
            </button>
        </form>
        <p id="brigade-or-agency-parameter-request-status" role="status"
           aria-label="Brigade or Agency Parameter read status">
            Pending, Received, Rejected, Timed out, Delivery failed.
        </p>
        <a href="@Url.Action("Index", "Parameters", new { address = communicationsAddress, agentType, parameterTable, selectedParameter = brigadeOrAgencyParameter.Number })">
            View @brigadeOrAgencyParameter.Name
        </a>
        }
        else if (participantParametersAvailable)
        {
        <table>
            <caption>@parameterTableName @agentType Parameter Table</caption>
            <thead>
                <tr>
                    <th scope="col">Number</th>
                    <th scope="col">Name</th>
                    <th scope="col">Value</th>
                    <th scope="col">Read State</th>
                    <th scope="col">Last Read</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var parameter in participantParameters)
                {
                <tr>
                    <td>@parameter.Number</td>
                    <th scope="row">@parameter.Name</th>
                    <td id="participant-parameter-@parameter.Number-value">
                        No Parameter values have been read.
                    </td>
                    <td id="participant-parameter-@parameter.Number-read-state">Not read</td>
                    <td id="participant-parameter-@parameter.Number-last-read"></td>
                </tr>
                }
            </tbody>
        </table>
        @foreach (var parameter in participantParameters)
        {
        <form class="inline-action participant-parameter-request"
              data-parameter-number="@parameter.Number"
              action="/participants/@participantPort/parameters/@parameterTable/@parameter.Number"
              method="post">
            <button type="submit">Request @parameter.Name</button>
        </form>
        <p id="participant-parameter-@parameter.Number-request-status" role="status"
           aria-label="@parameter.Name Parameter read status">
            Pending, Received, Rejected, Timed out, Delivery failed.
        </p>
        }
        }
        else
        {
        <p role="status">
            This Agent Type's Parameter catalogue and read workflow are unavailable for the
            selected Communications Address.
        </p>
        }
        </section>

        @if (isRouter)
        {
        <section class="panel" aria-labelledby="routing-table-heading">
        <p class="panel-kicker">@parameterTableName parameter values</p>
        <h2 id="routing-table-heading">@parameterTableName Router @selectedRouterTable!.Name entries</h2>
        <form class="inline-action" id="routing-table-request"
              action="/router/parameters/@parameterTable/@selectedRouterTable.ParameterNumber.Value/entries/1-1" method="post">
            <label for="routing-table-first-entry">First entry</label>
            <input id="routing-table-first-entry" name="first-entry" type="number"
                   min="1" step="1" value="1" required />
            <label for="routing-table-last-entry">Last entry</label>
            <input id="routing-table-last-entry" name="last-entry" type="number"
                   min="1" step="1" value="1" required />
            <button id="routing-table-request-submit" type="submit">
                Request entries
            </button>
        </form>
        <p id="routing-table-request-range">Requested entries: 1 through 1.</p>
        <p id="routing-table-request-status" role="status"
           aria-label="@selectedRouterTable.Name request status">
            Pending, Received, Rejected, Timed out, Delivery failed.
        </p>
        <table id="routing-table-results" hidden>
            <caption>@parameterTableName Router @selectedRouterTable.Name entries</caption>
            <thead>
                <tr>
                    @foreach (var column in selectedRouterTableColumns)
                    {
                    <th scope="col">@column.Header</th>
                    }
                </tr>
            </thead>
            <tbody></tbody>
        </table>
        <button id="routing-table-next-entries" type="button" disabled
                aria-controls="routing-table-results">
            Next entries
        </button>
        </section>
        }
    </div>
</div>

@if (isRouter || participantParametersAvailable)
{
<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/js/management-transactions.js"></script>
<script>
    const parameterTableSelector = document.getElementById("parameter-table");
    const formatParameterReadState = state =>
        `${state.charAt(0).toUpperCase()}${state.slice(1).replaceAll("-", " ")}`;

    const submitScalarParameterRequest = async (
        parameterRequestForm,
        parameterRequestButton,
        renderPending,
        renderResult,
        renderFailure) => {
        parameterRequestButton.disabled = true;
        renderPending();

        try {
            const result = await managementTransactions.submit(parameterRequestForm.action, { method: "POST" });
            renderResult(result);
        } catch {
            renderFailure();
        } finally {
            parameterRequestButton.disabled = false;
        }
    };

    parameterTableSelector.addEventListener("change", () => {
        const url = new URL(window.location.href);
        url.searchParams.set("parameterTable",
            parameterTableSelector.value.toLowerCase().replaceAll(" ", "-"));
        window.location.assign(url);
    });
</script>
}

@if (isRouter)
{
<script>
    const selectedParameterTable = "@parameterTable";
    const selectedRouterTableParameterNumber = @selectedRouterTable!.ParameterNumber.Value;
    const parameterRequestForm = document.getElementById("brigade-or-agency-parameter-request");
    const parameterRequestButton = document.getElementById(
        "brigade-or-agency-parameter-request-submit");
    const parameterRequestStatus = document.getElementById(
        "brigade-or-agency-parameter-request-status");
    const brigadeOrAgencyValue = document.getElementById("brigade-or-agency-value");
    const brigadeOrAgencyReadState = document.getElementById("brigade-or-agency-read-state");
    const brigadeOrAgencyLastRead = document.getElementById("brigade-or-agency-last-read");
    const selectedRouterParameterRequestForm = document.getElementById(
        "selected-router-parameter-request");
    const selectedRouterParameterRequestButton = document.getElementById(
        "selected-router-parameter-request-submit");
    const selectedRouterParameterRequestStatus = document.getElementById(
        "selected-router-parameter-request-status");
    const selectedRouterParameterDetailValue = document.getElementById(
        "selected-router-parameter-value");
    const selectedRouterParameterNumber = @(selectedRouterParameter?.Number ?? 0);
    const selectedRouterParameterRowValue = selectedRouterParameterNumber === 1
        ? brigadeOrAgencyValue
        : document.getElementById(`router-parameter-${selectedRouterParameterNumber}-value`);
    const selectedRouterParameterRowReadState = selectedRouterParameterNumber === 1
        ? brigadeOrAgencyReadState
        : document.getElementById(`router-parameter-${selectedRouterParameterNumber}-read-state`);
    const selectedRouterParameterRowLastRead = selectedRouterParameterNumber === 1
        ? brigadeOrAgencyLastRead
        : document.getElementById(`router-parameter-${selectedRouterParameterNumber}-last-read`);
    const routingTableRequestForm = document.getElementById("routing-table-request");
    const routingTableRequestButton = document.getElementById("routing-table-request-submit");
    const routingTableFirstEntry = document.getElementById("routing-table-first-entry");
    const routingTableLastEntry = document.getElementById("routing-table-last-entry");
    const routingTableRequestRange = document.getElementById("routing-table-request-range");
    const routingTableRequestStatus = document.getElementById("routing-table-request-status");
    const routingTableResults = document.getElementById("routing-table-results");
    const routingTableResultRows = routingTableResults.querySelector("tbody");
    const routingTableNextEntries = document.getElementById("routing-table-next-entries");
    let nextRoutingTableEntryRange = null;

    parameterRequestForm.addEventListener("submit", async event => {
        event.preventDefault();
        await submitScalarParameterRequest(
            parameterRequestForm,
            parameterRequestButton,
            () => {
                brigadeOrAgencyReadState.textContent = "Pending";
                parameterRequestStatus.textContent = "Pending.";
            },
            result => {
                const state = formatParameterReadState(result.state);
                brigadeOrAgencyReadState.textContent = state;
                brigadeOrAgencyLastRead.textContent = new Date().toLocaleString();

                if (result.state === "received") {
                    brigadeOrAgencyValue.textContent = result.parameterValue ?? "No value returned.";
                    parameterRequestStatus.textContent =
                        `Received: ${brigadeOrAgencyValue.textContent}`;
                } else if (result.state === "rejected" && result.rejectionReason) {
                    brigadeOrAgencyValue.textContent = "Rejected";
                    parameterRequestStatus.textContent = `Rejected: ${result.rejectionReason}`;
                } else {
                    brigadeOrAgencyValue.textContent = state;
                    parameterRequestStatus.textContent = `${state}.`;
                }
            },
            () => {
                parameterRequestStatus.textContent = "The Parameter Request could not be submitted.";
            });
    });

    if (selectedRouterParameterRequestForm) {
        selectedRouterParameterRequestForm.addEventListener("submit", async event => {
            event.preventDefault();
            await submitScalarParameterRequest(
                selectedRouterParameterRequestForm,
                selectedRouterParameterRequestButton,
                () => {
                    selectedRouterParameterRowReadState.textContent = "Pending";
                    selectedRouterParameterRequestStatus.textContent = "Pending.";
                },
                result => {
                    const state = formatParameterReadState(result.state);
                    selectedRouterParameterRowReadState.textContent = state;
                    selectedRouterParameterRowLastRead.textContent = new Date().toLocaleString();

                    if (result.state === "received") {
                        selectedRouterParameterDetailValue.textContent =
                            result.parameterValue ?? "No value returned.";
                        selectedRouterParameterRowValue.textContent =
                            selectedRouterParameterDetailValue.textContent;
                        selectedRouterParameterRequestStatus.textContent =
                            `Received: ${selectedRouterParameterDetailValue.textContent}`;
                    } else if (result.state === "rejected" && result.rejectionReason) {
                        selectedRouterParameterDetailValue.textContent = "Rejected";
                        selectedRouterParameterRowValue.textContent = "Rejected";
                        selectedRouterParameterRequestStatus.textContent =
                            `Rejected: ${result.rejectionReason}`;
                    } else {
                        selectedRouterParameterDetailValue.textContent = state;
                        selectedRouterParameterRowValue.textContent = state;
                        selectedRouterParameterRequestStatus.textContent = `${state}.`;
                    }
                },
                () => {
                    selectedRouterParameterRowReadState.textContent = "Delivery failed";
                    selectedRouterParameterRowLastRead.textContent = new Date().toLocaleString();
                    selectedRouterParameterRowValue.textContent = "Delivery failed";
                    selectedRouterParameterDetailValue.textContent = "Delivery failed";
                    selectedRouterParameterRequestStatus.textContent = "Delivery failed.";
                });
        });
    }

    const updateRoutingTableRequest = (firstEntry, lastEntry) => {
        routingTableRequestForm.action =
            `/router/parameters/${selectedParameterTable}/${selectedRouterTableParameterNumber}/entries/${firstEntry}-${lastEntry}`;
        routingTableRequestRange.textContent =
            `Requested entries: ${firstEntry} through ${lastEntry}.`;
    };

    const setNextRoutingTableEntryRange = range => {
        nextRoutingTableEntryRange = range;
        routingTableNextEntries.disabled = range === null;
    };

    const renderRoutingTableEntries = entries => {
        routingTableResultRows.replaceChildren();
        for (const entry of entries) {
            const row = document.createElement("tr");
            @foreach (var column in selectedRouterTableColumns)
            {
            <text>
            const @Html.Raw(column.Property) = document.createElement("@(column.Property == "index" ? "th" : "td")");
            @if (column.Property == "index")
            {
            <text>@Html.Raw($"{column.Property}.scope = \"row\";")</text>
            }
            @Html.Raw($"{column.Property}.textContent = entry.{column.Property};")
            @Html.Raw($"row.append({column.Property});")
            </text>
            }
            routingTableResultRows.append(row);
        }

        routingTableResults.hidden = false;
    };

    const requestRoutingTableEntries = async (firstEntry, lastEntry, requestButton) => {
        updateRoutingTableRequest(firstEntry, lastEntry);
        setNextRoutingTableEntryRange(null);
        routingTableResults.hidden = true;
        routingTableResultRows.replaceChildren();
        requestButton.disabled = true;
        routingTableRequestStatus.textContent =
            `Pending: requesting entries ${firstEntry} through ${lastEntry}.`;

        try {
            const result = await managementTransactions.submit(routingTableRequestForm.action, { method: "POST" });
            const state = formatParameterReadState(result.state);

            if (result.state !== "received") {
                routingTableRequestStatus.textContent =
                    result.state === "rejected" && result.rejectionReason
                        ? `Rejected: ${result.rejectionReason}`
                        : `${state}.`;
                return;
            }

            const tableEntries = result.@selectedRouterTableResponseField ?? [];
            const hasMoreValues = result.moreValues === true;
            renderRoutingTableEntries(tableEntries);
            setNextRoutingTableEntryRange(hasMoreValues && tableEntries.length > 0
                ? { firstEntry: tableEntries.at(-1).index + 1, lastEntry }
                : null);
            const hasNextEntries = nextRoutingTableEntryRange !== null;
            routingTableNextEntries.disabled = !hasNextEntries;
            routingTableRequestStatus.textContent = tableEntries.length === 0
                ? "Received: No @selectedRouterTable.Name entries were returned."
                : `Received: ${tableEntries.length} @selectedRouterTable.Name entries.`;
        } catch {
            routingTableRequestStatus.textContent = "Delivery failed.";
        } finally {
            if (requestButton === routingTableNextEntries) {
                routingTableNextEntries.disabled = nextRoutingTableEntryRange === null;
            } else {
                requestButton.disabled = false;
            }
        }
    };

    routingTableRequestForm.addEventListener("submit", event => {
        event.preventDefault();
        const firstEntry = Number(routingTableFirstEntry.value);
        const lastEntry = Number(routingTableLastEntry.value);
        if (!Number.isInteger(firstEntry) || !Number.isInteger(lastEntry) ||
            firstEntry < 1 || lastEntry < firstEntry) {
            routingTableRequestStatus.textContent =
                "Rejected: last entry must be greater than or equal to first entry.";
            return;
        }

        void requestRoutingTableEntries(firstEntry, lastEntry, routingTableRequestButton);
    });

    routingTableNextEntries.addEventListener("click", () => {
        if (nextRoutingTableEntryRange === null) {
            return;
        }

        routingTableFirstEntry.value = nextRoutingTableEntryRange.firstEntry;
        routingTableLastEntry.value = nextRoutingTableEntryRange.lastEntry;
        void requestRoutingTableEntries(
            nextRoutingTableEntryRange.firstEntry,
            nextRoutingTableEntryRange.lastEntry,
            routingTableNextEntries);
    });
</script>
}
else if (participantParametersAvailable)
{
<script>
    for (const parameterRequestForm of document.querySelectorAll(
        ".participant-parameter-request")) {
        parameterRequestForm.addEventListener("submit", async event => {
            event.preventDefault();
            const parameterNumber = parameterRequestForm.dataset.parameterNumber;
            const requestButton = parameterRequestForm.querySelector("button");
            const value = document.getElementById(`participant-parameter-${parameterNumber}-value`);
            const readState = document.getElementById(
                `participant-parameter-${parameterNumber}-read-state`);
            const lastRead = document.getElementById(
                `participant-parameter-${parameterNumber}-last-read`);
            const status = document.getElementById(
                `participant-parameter-${parameterNumber}-request-status`);

            await submitScalarParameterRequest(
                parameterRequestForm,
                requestButton,
                () => {
                    readState.textContent = "Pending";
                    status.textContent = "Pending.";
                },
                result => {
                    const state = formatParameterReadState(result.state);
                    readState.textContent = state;
                    lastRead.textContent = new Date().toLocaleString();

                    if (result.state === "received") {
                        value.textContent = result.parameterValue ?? "No value returned.";
                        status.textContent = `Received: ${value.textContent}`;
                    } else if (result.state === "rejected" && result.rejectionReason) {
                        value.textContent = "Rejected";
                        status.textContent = `Rejected: ${result.rejectionReason}`;
                    } else {
                        value.textContent = state;
                        status.textContent = `${state}.`;
                    }
                },
                () => {
                    status.textContent = "The Parameter Request could not be submitted.";
                });
        });
    }
</script>
}
